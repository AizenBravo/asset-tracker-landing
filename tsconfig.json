{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@my_components/*": ["./app/components/*"],
      "@core/*": ["./app/core/*"],
      "@shadcn/*": ["./app/shadcn/*"],
      "@components/*": ["./app/shadcn/components/*"],
      "@lib/*": ["./app/shadcn/lib/*"],
      "@utils/*": ["./app/shadcn/utils/*"],
      "@hooks/*": ["./app/shadcn/hooks/*"],
      "@ui/*": ["./app/shadcn/ui/*"],
      "@backend/*": ["./app/(backend)/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
